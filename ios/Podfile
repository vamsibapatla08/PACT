# Circle's wallet SDK only ships through CocoaPods. Open Pact_App.xcworkspace, not the .xcodeproj.
source 'https://github.com/circlefin/w3s-ios-sdk.git'
source 'https://cdn.cocoapods.org/'

platform :ios, '26.0'

target 'Pact_App' do
  use_frameworks!
  pod 'CircleProgrammableWalletSDK', '~> 1.4'
end

# Circle's sample app setup: its dependencies need these to build on a new Xcode.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
    end
  end

  # Circle's PIN screens read their colours and text only from the SDK's own bundle,
  # so Pact's dark silver theme and plainer wording are copied over it on every install.
  bundle = 'Pods/CircleProgrammableWalletSDK/Resources/CircleProgrammableWalletSDKBundle.bundle'
  FileUtils.cp(['CircleTheme/CirclePWTheme.json', 'CircleTheme/CirclePWLocalizable.strings'], bundle)
  FileUtils.rm_rf("#{bundle}/_CodeSignature")
end
